Замена конкретного тега, слова:

count=0; for f in *.html; do
  if grep -q '<main>' "$f"; then
    sed -i 's/<main>/<main data-pagefind-body>/' "$f"
    echo "Изменён: $f"
    count=$((count + 1))
  fi
done
echo "---"
echo "Всего изменено файлов: $count"


